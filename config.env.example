# ============================================================
# plaud-obsidian-pipeline 설정
# 이 파일을 config.env 로 복사해서 값을 채우세요. (install.sh 가 자동 생성도 함)
#   cp config.env.example config.env
# config.env 는 .gitignore 처리되어 커밋되지 않습니다.
# 값에서 ~, $HOME, $VAULT_PATH 를 사용할 수 있습니다.
# ============================================================

# [필수] 옵시디언 볼트 루트 경로
VAULT_PATH=~/Obsidian/MyVault

# [선택] 오디오가 착지하는 폴더 (launchd 가 감시) — 기본: $VAULT_PATH/_inbox
#INBOX_DIR=$VAULT_PATH/_inbox

# [선택] 생성된 노트가 저장될 폴더 — 기본: $VAULT_PATH/Voice Memos
#OUTPUT_DIR=$VAULT_PATH/Voice Memos

# [선택] 처리 후 원본 오디오 보관 폴더 — 기본: $HOME/Obsidian/_audio-archive
#ARCHIVE_DIR=$HOME/Obsidian/_audio-archive

# [선택] 전사 언어 (ko, en, ja ...) — 기본: ko
WHISPER_LANG=ko

# [선택] whisper.cpp 모델 파일명 (models/ 안에 위치) — 기본: ggml-large-v3-turbo.bin
#WHISPER_MODEL=ggml-large-v3-turbo.bin

# [선택] PLAUD 클라우드 pull 주기(초) — 기본: 900 (15분)
#PULL_INTERVAL=900

# [선택] 요약 프롬프트를 담은 텍스트 파일 경로. 비우면 내장(한국어) 6섹션 회의록 프롬프트 사용.
#        커스텀 프롬프트는 "TITLE: ... / ---SPEAKERS--- / ---BODY---" 출력 계약을 지켜야 합니다
#        (SPEAKERS 블록은 없어도 됨). Claude Code(claude CLI) 가 없으면 요약을 건너뛰고
#        전사 원문만 노트로 저장합니다.
#SUMMARY_PROMPT_FILE=~/my-summary-prompt.txt

# [선택] claude -p 요약에 쓸 모델 — 기본: sonnet
#CLAUDE_MODEL=sonnet

# ------------------------------------------------------------
# 전사 엔진 (선택) — 아래 둘 다 비워두면 100% 로컬(whisper.cpp)로만 동작합니다.
# 체인: AssemblyAI(클라우드, 화자분리) → WhisperX(로컬, 화자분리) → whisper.cpp(로컬)
# ------------------------------------------------------------

# [선택] AssemblyAI API 키 — 넣으면 클라우드 전사+화자분리(universal-2)를 1순위로 사용.
#        ⚠️ 키를 넣으면 오디오가 AssemblyAI 서버로 전송됩니다 (README 프라이버시 절 참고).
#        레포 루트 .assemblyai_key 파일 또는 환경변수 ASSEMBLYAI_API_KEY 로도 지정 가능.
#ASSEMBLYAI_API_KEY=

# [선택] HuggingFace 토큰 — 로컬 화자분리(WhisperX+pyannote)용. .venv-whisperx 셋업 필요
#        (README 'WhisperX' 절 참고). 레포 루트 .hf_token 파일로도 지정 가능.
#HF_TOKEN=

# [선택] 아카이브 오디오 보관일 — 이 일수보다 오래된 아카이브 오디오를 매일 03:00 에 삭제.
#        0(기본)이면 자동삭제 안 함. 원본은 PLAUD 클라우드에 남아 있어 다시 받을 수 있습니다.
#AUDIO_RETENTION_DAYS=0
