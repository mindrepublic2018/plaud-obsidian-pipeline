# 사용자별 설정 (시크릿/개인 경로 포함) — 절대 커밋 금지
config.env
# 백업·사본까지 차단 (config.env.bak / .save / .local ...) — 예제 파일만 예외
config.env.*
!config.env.example
.env
.assemblyai_key
.hf_token
.anthropic_key
.openai_key

# WhisperX 전용 venv (선택 기능, 로컬 생성)
.venv-whisperx/

# 런타임 상태 (개인 녹음 ID, 락, 실패 카운트)
state/
# v1 레거시 위치 (자동 마이그레이션 전 잔재)
pulled_ids.txt
skipped_ids.txt
.lock

# 로그
logs/

# whisper 모델 (~1.5GB, 설치 시 다운로드)
models/
*.bin

# 오디오 (개인 녹음) — process_inbox.py 의 AUDIO_EXT 전체와 일치
*.mp3
*.m4a
*.wav
*.aac
*.opus
*.flac
*.aiff
*.aif
*.ogg
*.webm
*.mp4
*.m4v

# OS / 에디터
.DS_Store
__pycache__/
*.pyc

# 도구 아티팩트 (oh-my-claudecode 등)
.omc/

# 로컬 툴 상태
.orca/
